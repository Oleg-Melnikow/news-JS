{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noImplicitAny": true,
    "esModuleInterop": true,
    "skipLibCheck": true,

    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    "outDir": "./dist/",
    "rootDir": "./src",

    "allowJs": true,
    "checkJs": false,
    "paths": {
      "interfaces/*": ["./src/types/*"],
      "helpers/*": ["./src/helpers/*"],
      "assets/*": ["./src/assets/*"]
    },
    "types": ["node"]
  },
  "include": ["./src/**/*", "index.d.ts"],
  "exclude": ["node_modules"]
}
